
{
    "workbench.startupEditor": "none",
    "security.workspace.trust.untrustedFiles": "open",
    "window.newWindowProfile": "Default",

    "editor.fontSize": 14,
    "editor.fontWeight": "normal",
    "editor.lineHeight": 1.4,
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "trailing",
    "editor.dragAndDrop": false,
    "editor.occurrencesHighlight": "off",
    "editor.bracketPairColorization.enabled": false,
    "editor.guides.bracketPairsHorizontal": false,
    "editor.fontFamily": "'Cascadia Code SemiLight', Monaco, Menlo, 'Courier New', monospace",
    "editor.trimAutoWhitespace": true,

    "interactiveWindow.alwaysScrollOnNewCell": false,
    "notebook.output.scrolling": true,
    "notebook.lineNumbers": "on",
    "jupyter.askForKernelRestart": false,

    "git.openRepositoryInParentFolders": "always",
    "githubPullRequests.createOnPublishBranch": "never",
    "diffEditor.ignoreTrimWhitespace": false,

    "python.defaultInterpreterPath": "/Users/adam/opt/miniconda3/bin/python",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "none"
    },
    "[python]": {
        "editor.formatOnType": true
    },
    "editor.tokenColorCustomizations": {
        "[Tomorrow]": {
            "textMateRules": [
                {
                    "scope": "meta.function-call.arguments",
                    "settings": {
                        "foreground": "#4D4D4C",
                    }
                },
                {
                    "scope": "variable.parameter.function",
                    "settings": {
                        "fontStyle": "italic"
                    }
                }
            ]
        },
        "[Tomorrow Night*]": {
            "textMateRules": [
                {
                    "scope": "meta.function-call.arguments",
                    "settings": {
                        "foreground": "#CCCCCC",
                    }
                },
                {
                    "scope": "variable.parameter.function",
                    "settings": {
                        "fontStyle": "italic"
                    }
                }
            ]
        },
    },
    "workbench.colorCustomizations": {
		"editor.lineHighlightBackground": "#ffffff",
        "editor.lineHighlightBorder": "#EEEEEE",
        "editor.selectionBackground": "#add6ff60",
        "editor.selectionHighlightBackground": "#add6ff60",

        "editor.findMatchBackground": "#add6ff60",
        "editor.findMatchBorder": "#add6ffd0",

        "editor.findMatchHighlightBackground": "#ea5c0020",
        "editor.findMatchHighlightBorder": "#ea5c0080",
        "editor.rangeHighlightBackground": "#ea5c0010",

        "editor.snippetTabstopHighlightBorder": "#ffd70080",
        "editor.snippetTabstopHighlightBackground": "#ffd70040",
        "editor.snippetFinalTabstopHighlightBackground": "#ff450040",
        "editor.snippetFinalTabstopHighlightBorder": "#ff450080",
    },

    "php.validate.executablePath": "/opt/homebrew/bin/php",

    "vim.cursorStylePerMode.insert": "line",
    "vim.cursorStylePerMode.normal": "underline",
    "vim.cursorStylePerMode.replace": "block",
    "vim.cursorStylePerMode.visual": "underline",
    "vim.cursorStylePerMode.visualblock": "underline",
    "vim.cursorStylePerMode.visualline": "block-outline",
    "vim.hlsearch": true,
    "vim.leader": " ",
    "vim.normalModeKeyBindings": [
        {
            "before": ["s"],
            "commands": [":w"]
        },
        {
            "before": ["leader", "q"],
            "commands": [":q"]
        },
        {
            "before": ["H"],
            "commands": [":bp"]
        },
        {
            "before": ["L"],
            "commands": [":bn"]
        },
        {
            "before": ["leader", "d"],
            "commands": [":bd"]
        },
        {
            "before": ["M"],
            "after": ["C-w", "w"]
        },
        {
            "before": ["leader", "h"],
            "commands": [":noh"]
        }
    ],
    "vim.visualModeKeyBindings": [
        {
            "before": ["p"],
            "after": ["\"", "_", "d", "P"]
        },
    ],
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],
    "diffEditor.renderSideBySide": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.colorTheme": "Tomorrow",
}